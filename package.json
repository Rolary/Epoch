{
  "name": "eco-era",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite apps/web",
    "db:init": "tsx apps/api/src/init-db.ts",
    "preview:web": "vite preview apps/web",
    "preview:web:host": "pnpm run build:gzip && vite preview apps/web --host 0.0.0.0",
    "start": "tsx apps/api/src/server.ts",
    "start:api": "tsx apps/api/src/server.ts",
    "assets:compress": "powershell -ExecutionPolicy Bypass -File scripts/compress-ui-assets.ps1",
    "assets:restore-originals": "powershell -ExecutionPolicy Bypass -File scripts/compress-ui-assets.ps1 -RestoreOriginals",
    "build": "tsc -b && vite build apps/web",
    "build:gzip": "pnpm run build && node scripts/gzip-dist.mjs apps/web/dist",
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "typecheck": "tsc -b",
    "smoke:chapter2": "node scripts/chapter2-smoke.mjs",
    "smoke:chapter3": "node scripts/chapter3-smoke.mjs",
    "test": "vitest run"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "fastify": "^5.8.5",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "vitest": "^4.1.6"
  }
}
